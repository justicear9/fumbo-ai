# Local only — copy to .env.local and fill in.
# On the live Node app, add the same keys in cPanel Environment (then restart).

# Hunter (Fumbo BDR). This is the primary destination for demo requests.
HUNTER_LEAD_URL=https://bdr.fumbo.ai/api/webhooks/site-lead
HUNTER_LEAD_SECRET=

# Optional backup inbox. Form still works if only Hunter is set.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@fumbo.ai
SMTP_PASS=
SMTP_FROM="Fumbo Ai <hello@fumbo.ai>"
CONTACT_TO=hello@fumbo.ai
