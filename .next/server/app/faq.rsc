f:Tb00,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How soon can this be live?","acceptedAnswer":{"@type":"Answer","text":"A first slice can be live in weeks, not a six-month programme. We pick one channel or one workflow, ship it to real customers, then widen with your team."}},{"@type":"Question","name":"Does it work with WhatsApp and the tools we already have?","acceptedAnswer":{"@type":"Answer","text":"Yes. Chat sits on web, WhatsApp, social, and email. Automations connect those threads to the CRM, helpdesk, and ops tools you already run, so staff are not copying chats into another system."}},{"@type":"Question","name":"What do we need to give you to start?","acceptedAnswer":{"@type":"Answer","text":"How customers reach you today, the ten questions your team answers every day, and access to the systems those chats already create work in. We do not need a full data science team on your side."}},{"@type":"Question","name":"Will this replace our staff?","acceptedAnswer":{"@type":"Answer","text":"No. Fumbo takes the repeat questions and the copy-paste work. Anything that needs judgment goes to a person, with the full thread attached."}},{"@type":"Question","name":"What if the assistant gets an answer wrong?","acceptedAnswer":{"@type":"Answer","text":"It should hand off. We set the topics it is allowed to handle, the tone, and when a human takes over. After launch we tune from real chats so the misses shrink."}},{"@type":"Question","name":"How do we know it is working?","acceptedAnswer":{"@type":"Answer","text":"We agree the measure before we ship: faster replies, fewer tickets, more completed orders, or fewer dropped WhatsApp threads. You see that on live traffic, not a slide."}},{"@type":"Question","name":"Who owns the conversations and our data?","acceptedAnswer":{"@type":"Answer","text":"You do. Access, retention, and where the system runs sit in the agreement. We do not train a public model on your customer chats."}},{"@type":"Question","name":"How do you charge?","acceptedAnswer":{"@type":"Answer","text":"We scope after we see your channels and volume. A demo maps a first slice and a price for that slice. There is no public rate card because a pharmacy WhatsApp bot and a newsroom desk are not the same job."}},{"@type":"Question","name":"Do you disappear after launch?","acceptedAnswer":{"@type":"Answer","text":"No. Products change, new questions show up, and flows drift. We stay on for maintenance and tuning so the assistant still matches how you sell and support."}},{"@type":"Question","name":"Can we start on one channel?","acceptedAnswer":{"@type":"Answer","text":"Yes. Most teams start on WhatsApp or the website, prove it with real customers, then add the rest. That is the engagement, not a full rebuild on day one."}}]}6:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$f"}}]
7:["$","$L10",null,{"eyebrow":"FAQ","title":"Before you book a demo","titleClassName":"max-w-[26ch] lg:max-w-none lg:whitespace-nowrap","description":"Time, tools, staff, and what we need from you. Straight answers."}]
